PORT=3000

# Sign in with GitHub — github.com → Settings → Developer settings → OAuth Apps
# Callback URL: https://YOUR-APP.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Google — console.cloud.google.com → Credentials → OAuth client ID
# Redirect URI: https://YOUR-APP.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your site's public address, no trailing slash. Used to build callback URLs.
PUBLIC_URL=https://YOUR-APP.onrender.com

# Ask LSP-Pay — the in-app assistant. Gemini is used when this is set.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash. If the default 404s, sign in and
# open /api/ai/models to see what your key can actually use.
GEMINI_MODEL=

# Alternatives, used only if GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Signs the bot-protection challenges; falls back to JWT_SECRET.
SHIELD_SECRET=
